{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/hooks/detect-design-context.sh",
						"timeout": 10,
						"description": "Nudge mockingbird when a design artefact, spec or plan is written"
					}
				]
			}
		]
	}
}
