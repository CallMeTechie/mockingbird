/* docs/design/mockups/tokens.css
   Generiert im Design-Dialog (Phase 3). Werte hier MÜSSEN mit
   docs/design/design-system.md übereinstimmen — beide entstehen zusammen.
   Jedes Artboard verlinkt diese Datei; keine Werte inline duplizieren. */
:root {
	/* Farben */
	--color-surface: #ffffff;
	--color-text: #1a1a1a;
	--color-text-muted: #6b6b6b;
	--color-border: #d9d9d9;
	--color-accent: #2f5bd7;
	--color-success: #1a7f37;
	--color-warning: #9a6700;
	--color-error: #cf222e;

	/* Typografie */
	--type-page-title: 600 1.5rem/1.3 system-ui, sans-serif;
	--type-heading: 600 1.125rem/1.4 system-ui, sans-serif;
	--type-body: 400 0.9375rem/1.5 system-ui, sans-serif;
	--type-caption: 400 0.8125rem/1.4 system-ui, sans-serif;

	/* Abstände (4px-Basis) */
	--space-1: 4px;
	--space-2: 8px;
	--space-4: 16px;
	--space-8: 32px;

	/* Radien / Schatten */
	--radius-sm: 4px;
	--radius-md: 8px;
	--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.08);
}

@media (prefers-color-scheme: dark) {
	:root {
		--color-surface: #16181c;
		--color-text: #e6e6e6;
		--color-text-muted: #9a9a9a;
		--color-border: #33363b;
	}
}
