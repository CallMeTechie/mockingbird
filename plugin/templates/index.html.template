<html lang="de">
<head>
	<meta charset="utf-8">
	<title>Mockups — Kontaktbogen</title>
	<link rel="stylesheet" href="./tokens.css">
	<style>
		body { font: var(--type-body); color: var(--color-text); background: var(--color-surface); margin: 0; padding: var(--space-8); }
